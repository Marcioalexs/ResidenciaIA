{
  "manifest_version": 3,
  "name": "C1NC0 — Pensamento Crítico",
  "version": "1.0.2",
  "description": "Extensão opcional do C1NC0: identifica páginas jornalísticas e agiliza o envio da URL ao Painel de Pensamento Crítico.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "C1NC0 — Analisar página atual",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
