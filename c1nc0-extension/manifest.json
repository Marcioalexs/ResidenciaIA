{
  "manifest_version": 3,
  "name": "C1NC0 — Pensamento Crítico",
  "version": "1.0.1",
  "description": "Identifica páginas com características jornalísticas e oferece acesso ao Painel C1NC0.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "C1NC0 — Analisar página atual",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
